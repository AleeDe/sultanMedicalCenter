# Local development: Docker Postgres from docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tokgen

# Supabase. Which port depends on where the app runs:
#
#   5432  session mode      — a long-lived server, migrations, scripts.
#                             Capped at ~15 client connections PER PROJECT.
#   6543  transaction mode  — serverless (Vercel). Every warm lambda holds
#                             its own pool, so session mode runs out.
#
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Transaction mode does NOT break gapless numbering (a transaction is pinned
# to one backend); it breaks prepared statements, and db.ts handles that by
# detecting the port. Run `npm run test:db` after pointing this at a new host.

# Drives current_date, and therefore when the token series resets.
# NOTE: on Supabase the pooler drops this — migration 0013 pins it on the
# database itself, so change it in BOTH places.
CLINIC_TIMEZONE=Asia/Karachi

# Optional. Defaults to 3 on port 6543 and 5 on 5432. Raise only alongside
# the Supabase connection limit, never on its own.
# DB_POOL_MAX=

# Optional: demo video narration via ElevenLabs (most natural, carries emotion).
# Without it the build falls back to the offline Piper voice.
# Free tier is 10k characters/month; the script is ~1,200.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
